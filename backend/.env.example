# Server
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/bulkmail

# Admin login (single static admin — no user collection needed)
ADMIN_EMAIL=admin@bulkmail.com
ADMIN_PASSWORD=Admin@123
JWT_SECRET=change_this_to_a_long_random_string

# SMTP (example: Gmail app password, or use Mailtrap for safe testing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Bulk Mailer <your_email@gmail.com>"
